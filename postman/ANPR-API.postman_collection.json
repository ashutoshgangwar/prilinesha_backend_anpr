{
  "info": {
    "name": "Prilinesha ANPR API",
    "description": "Run the requests **in order** — each one saves what the next needs.\n\n1-3  log in as the super admin, sign a customer up, inspect the session\n4-7  create the project (returns the Intozi API key once) and its gates\n8-10 grant the customer access to the project\nthen the vehicle registry, the camera ingest and the Intozi feed\nfinally the isolation checks, which must all fail with 401/403\n\nSet super_admin_email / super_admin_password first; everything else is captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5050",
      "type": "string"
    },
    {
      "key": "super_admin_email",
      "value": "admin@prilinesha.com",
      "type": "string"
    },
    {
      "key": "super_admin_password",
      "value": "ChangeMe123",
      "type": "string"
    },
    {
      "key": "super_admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "group_id",
      "value": "ACME_MALL",
      "type": "string"
    },
    {
      "key": "project_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "replace-with-your-api-key",
      "type": "string"
    },
    {
      "key": "transaction_id",
      "value": "108",
      "type": "string"
    },
    {
      "key": "feed_cursor",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health - liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('service is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Health - readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health/ready",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health",
            "ready"
          ]
        }
      }
    },
    {
      "name": "1. Auth - super admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Log in as the super admin seeded from SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD. Saves the token to {{super_admin_token}}.",
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{super_admin_email}}\",\n  \"password\": \"{{super_admin_password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test('role is super_admin', () => pm.expect(d.user.role).to.eql('super_admin'));",
              "pm.test('scoped to every project', () => pm.expect(d.user.group_ids).to.eql('ALL'));",
              "pm.collectionVariables.set('super_admin_token', d.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Auth - customer signs up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Creates a customer admin with NO project access. The role is forced to \"admin\" — a role in the body is ignored. Saves {{user_id}} and {{token}}.",
        "url": {
          "raw": "{{base_url}}/api/auth/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "signup"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ravi Sharma\",\n  \"email\": \"ravi@acmemall.com\",\n  \"password\": \"AcmePass123\",\n  \"phone_number\": \"+91 9876543210\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 created', () => pm.response.to.have.status(201));",
              "const d = pm.response.json().data;",
              "pm.test('forced to admin role', () => pm.expect(d.user.role).to.eql('admin'));",
              "pm.test('no project access yet', () => pm.expect(d.user.group_ids).to.eql([]));",
              "pm.collectionVariables.set('user_id', d.user.id);",
              "pm.collectionVariables.set('token', d.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Auth - who am I",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "description": "Identity, role, permissions and assigned projects — read fresh from the database, so a revoked project shows up immediately.",
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('permissions are listed', () => pm.expect(pm.response.json().data.permissions).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Projects - create (super admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{super_admin_token}}"
          }
        ],
        "description": "Creates the tenant and issues the Intozi API key. The key is returned ONCE — only its SHA-256 is stored. Saves it to {{project_key}}.",
        "url": {
          "raw": "{{base_url}}/api/projects",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "projects"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_id\": \"{{group_id}}\",\n  \"project_name\": \"Acme Mall Parking\",\n  \"customer_name\": \"Acme Retail Pvt Ltd\",\n  \"contact_email\": \"ops@acmemall.com\",\n  \"devices\": [\n    {\n      \"device_name\": \"entry1\",\n      \"direction\": \"entry\"\n    },\n    {\n      \"device_name\": \"exit1\",\n      \"direction\": \"exit\"\n    },\n    {\n      \"device_name\": \"exit2\",\n      \"direction\": \"exit\"\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 created', () => pm.response.to.have.status(201));",
              "const d = pm.response.json().data;",
              "pm.test('api_key returned once', () => pm.expect(d.api_key).to.be.a('string'));",
              "pm.test('gates attached', () => pm.expect(d.project.devices).to.have.lengthOf(3));",
              "pm.collectionVariables.set('project_key', d.api_key);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Projects - list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{super_admin_token}}"
          }
        ],
        "description": "A super admin sees every project; a customer admin sees only their assigned ones.",
        "url": {
          "raw": "{{base_url}}/api/projects?page=1&limit=25",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "projects"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "25"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
