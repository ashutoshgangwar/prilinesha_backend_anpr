    {
      "name": "Dashboard - register vehicle (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "description": "Internal dashboard: add a vehicle. Re-sending the same plate renews it (200) instead of duplicating. Authenticated with a dashboard token; scoped to the caller’s projects.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_number\": \"MH12AB1234\",\n  \"name\": \"Ramesh Kumar\",\n  \"phone_number\": \"+91 9876543210\",\n  \"valid_till\": \"2027-03-31\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/vehicles",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "vehicles"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201 (created) or 200 (renewed)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const v = pm.response.json().data;",
              "pm.test('plate stored uppercase', () => pm.expect(v.vehicle_number).to.eql('MH12AB1234'));",
              "pm.test('status derived from valid_till', () => pm.expect(v.status).to.be.oneOf(['registered', 'unregistered']));"
            ]
          }
        }
      ]
    },
    {
      "name": "Dashboard - register vehicle at all gates (all_devices)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "description": "`all_devices: true` is the form's \"all gates\" tick: every active gate of the project is stored on the record by name, rather than being implied by an empty list. Send `device_names` instead to restrict the vehicle to the gates the operator picked — those names are validated against the project, so a typo is a 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_number\": \"MH12ZZ7788\",\n  \"name\": \"Anita Rao\",\n  \"phone_number\": \"+91 9876543299\",\n  \"valid_till\": \"2027-03-31\",\n  \"all_devices\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/vehicles",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "vehicles"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201 (created) or 200 (renewed)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "const v = pm.response.json().data;",
              "pm.test('every gate written out by name', () => pm.expect(v.device_names).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ]
    },
