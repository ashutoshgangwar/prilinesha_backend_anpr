            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Projects - add a gate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{super_admin_token}}"
          }
        ],
        "description": "Device names are unique within a project, case-insensitively.",
        "url": {
          "raw": "{{base_url}}/api/projects/{{group_id}}/devices",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "projects",
            "{{group_id}}",
            "devices"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_name\": \"exit3\",\n  \"label\": \"Basement exit\",\n  \"direction\": \"exit\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "7b. Projects - list the gates (vehicle form picker)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "description": "The gate list the vehicle-registration form binds to. Returns `device_names` — one entry for a project with one gate, all of them for a project with several — plus the full device objects. Not super-admin only: a customer admin reads the gates of their own project. Switched-off gates are left out; add `?include_inactive=true` to see them. `GET /api/projects/devices` is the same list for a caller assigned to exactly one project, with no group_id in the path.",
        "url": {
          "raw": "{{base_url}}/api/projects/{{group_id}}/devices",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "projects",
            "{{group_id}}",
            "devices"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 ok', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test('device_names is a list of gate names', () => pm.expect(d.device_names).to.be.an('array'));",
              "pm.test('one entry per returned device', () => pm.expect(d.device_names.length).to.eql(d.devices.length));",
              "if (d.device_names.length) pm.collectionVariables.set('device_name', d.device_names[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Users - assign the project (THE ACCESS GRANT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{super_admin_token}}"
          }
        ],
        "description": "The moment the signed-up customer can see anything. mode is replace (default), add or remove. Takes effect on their VERY NEXT request — no re-login.",
        "url": {
          "raw": "{{base_url}}/api/users/{{user_id}}/projects",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "{{user_id}}",
            "projects"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_ids\": [\n    \"{{group_id}}\"\n  ],\n  \"mode\": \"replace\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('project now assigned', () => pm.expect(pm.response.json().data.group_ids).to.include(pm.collectionVariables.get('group_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Users - list",
      "request": {
