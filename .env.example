# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5050

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/vehicle_lpr
MONGO_MAX_RETRIES=10
MONGO_RETRY_DELAY_MS=3000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Camera authentication (required)
#
# The legacy shared key. Per-project keys (pk_…) are issued by
# POST /api/projects and are what new deployments should use — this one is
# unscoped and can read every project's feed.
#
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
API_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Dashboard authentication (required)
#
# JWT_SECRET signs dashboard access tokens; at least 32 characters. Changing it
# invalidates every issued token, which is how you force a global logout.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h
JWT_ISSUER=prilinesha-anpr
BCRYPT_ROUNDS=12

# Refresh tokens (POST /api/auth/refresh). Signed with their own key so an
# access token can never be replayed as a refresh token, or the reverse.
# Leave JWT_REFRESH_SECRET empty and one is derived from JWT_SECRET; set it
# explicitly (>= 32 chars, different from JWT_SECRET) to rotate the two apart.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Concurrent refresh tokens (roughly: signed-in devices) per account. Logging
# in past the cap silently signs out the oldest device.
MAX_ACTIVE_SESSIONS=5

# Public signup (POST /api/auth/signup). New accounts are always customer
# admins with no project access until a super admin assigns one. Set to false
# once every customer account exists.
SIGNUP_ENABLED=true

# Attempts per IP per window on /api/auth/login, /api/auth/signup and
# /api/auth/refresh. Successful calls are not counted.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# First super admin
#
# Seeded on boot ONLY when no super admin exists yet — someone has to be able
# to create projects and assign users before anything else works. Log in,
# change the password, then clear SUPER_ADMIN_PASSWORD from the environment.
# Leave both blank to skip seeding.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PATH=/uploads
SERVE_UPLOADS=true
MAX_IMAGE_BYTES=10485760

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
JSON_BODY_LIMIT=15mb
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Logging & docs
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs
SWAGGER_ENABLED=true
